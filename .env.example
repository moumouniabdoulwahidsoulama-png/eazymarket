# ============ Django ============
DJANGO_SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ============ Base de données (laisser vide = SQLite) ============
# DB_ENGINE=postgresql
# DB_NAME=eazymarket
# DB_USER=eazymarket
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ============ Identité du site ============
SITE_NAME=EazyMarket
SITE_TAGLINE=Achetez. Trouvez un pro. Au même endroit.
SITE_CITY=Ouagadougou
SITE_COUNTRY=Burkina Faso
SUPPORT_PHONE=+226 64 69 12 08
SUPPORT_WHATSAPP=22664691208
SUPPORT_WHATSAPP_2=22677552087
CONTACT_EMAIL=contact@eazymarket.bf

# ============ E-mail (SMTP) ============
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.eazymarket.bf
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@eazymarket.bf
# EMAIL_HOST_PASSWORD=

# ============ Boutique — emplacements produits ============
SHOP_FREE_SLOTS=2          # annonces offertes à chaque nouveau vendeur
SHOP_PACK_SIZE=10          # nombre d'annonces par pack acheté
SHOP_PACK_PRICE=5000       # prix du pack en FCFA

# ============ Boutique — commission ============
COMMISSION_RATE=5          # % ajouté au prix vendeur
COMMISSION_MIN=100         # commission plancher en FCFA

# ============ Services — artisans ============
ARTISAN_SUB_PRICE=1000     # abonnement artisan
ARTISAN_SUB_DAYS=60        # durée en jours (2 mois)
ARTISAN_FREE_LAUNCH=False  # True = tous les profils visibles gratuitement (lancement)
ARTISAN_BOOST_PRICE=2000   # mise en avant page d'accueil
ARTISAN_BOOST_DAYS=7

# ============ Services — déblocage du contact ============
CONTACT_UNLOCK_PRICE=200   # ce que paie le client pour voir le numéro d'un artisan
CONTACT_UNLOCK_DAYS=90     # durée de validité du déblocage
CONTACT_FREE_UNLOCKS=1     # contacts offerts à chaque nouveau client

# ============ Livreurs ============
DELIVERY_REQUIRED_SHARES=3 # personnes à parrainer avant activation

# ============ Livraison ============
DELIVERY_FEE_CITY=1000
DELIVERY_FEE_OUT=2500
FREE_DELIVERY_FROM=50000
PAYOUT_MIN=5000
PAYOUT_DELAY_DAYS=3

# ============ Paiements ============
# manual = le client paie sur vos numéros et saisit l'ID de transaction
# cinetpay = paiement automatique (Orange Money, Moov, Wave, carte)
PAYMENT_PROVIDER=manual
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Vos numéros marchands Orange Money ---
ORANGE_USSD_TEMPLATE=*144*10*{numero}*{montant}#
ORANGE_MONEY_NUMBER_1=+226 64 69 12 08
ORANGE_MONEY_WHATSAPP_1=22664691208
ORANGE_MONEY_NUMBER_2=+226 46 31 90 94
ORANGE_MONEY_NAME=EAZYMARKET
MOOV_MONEY_NUMBER=+226 02 09 66 85
WAVE_NUMBER=+226 77 55 20 87
WAVE_WHATSAPP=22677552087

# --- CinetPay (https://cinetpay.com) — quand vous passerez à l'automatique ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
