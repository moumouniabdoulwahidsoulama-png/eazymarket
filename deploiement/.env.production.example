# =====================================================================
# EazyMarket — configuration de PRODUCTION (LWS / cPanel)
# Copier ce fichier en « .env » à la racine de l'application, puis
# remplacer toutes les valeurs marquées « À REMPLIR ».
# Ce fichier contient vos mots de passe : ne le mettez jamais sur GitHub.
# =====================================================================

# ---------- Django ----------
# Générer une clé neuve :  python -c "import secrets;print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=A_REMPLIR_UNE_LONGUE_CHAINE_ALEATOIRE
DJANGO_DEBUG=False

# Le sous-domaine, avec et sans www
DJANGO_ALLOWED_HOSTS=boutique.VOTRE-DOMAINE.com,www.boutique.VOTRE-DOMAINE.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://boutique.VOTRE-DOMAINE.com,https://www.boutique.VOTRE-DOMAINE.com

# Mettre à False tant que le certificat HTTPS n'est pas installé,
# sinon le site boucle en redirections.
SECURE_SSL_REDIRECT=True

# ---------- Chemins servis par Apache ----------
# Dossier public du sous-domaine créé par cPanel. Remplacer UTILISATEUR
# par votre nom d'utilisateur cPanel et le nom du dossier si besoin.
DJANGO_STATIC_ROOT=/home/UTILISATEUR/boutique.VOTRE-DOMAINE.com/static
DJANGO_MEDIA_ROOT=/home/UTILISATEUR/boutique.VOTRE-DOMAINE.com/media
DJANGO_LOG_DIR=/home/UTILISATEUR/eazymarket/logs

# Laisser True : garantit que les photos s'affichent même si Apache ne sert
# pas /media/ directement. Passer à False une fois le .htaccess en place.
DJANGO_SERVE_MEDIA=True

# ---------- Base de données MySQL / MariaDB ----------
# Créée dans cPanel → Bases de données MySQL. Le préfixe du compte cPanel
# fait partie du nom (ex : monuser_eazymarket).
DB_ENGINE=mysql
DB_NAME=A_REMPLIR
DB_USER=A_REMPLIR
DB_PASSWORD=A_REMPLIR
DB_HOST=localhost
DB_PORT=3306

# ---------- Identité du site ----------
SITE_NAME=EazyMarket
SITE_TAGLINE=Achetez. Trouvez un pro. Au même endroit.
SITE_CITY=Ouagadougou
SITE_COUNTRY=Burkina Faso
SUPPORT_PHONE=+226 64 69 12 08
SUPPORT_WHATSAPP=22664691208
SUPPORT_PHONE_2=+226 77 55 20 87
SUPPORT_WHATSAPP_2=22677552087
CONTACT_EMAIL=contact@VOTRE-DOMAINE.com

# ---------- E-mail (compte créé dans cPanel) ----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.VOTRE-DOMAINE.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@VOTRE-DOMAINE.com
EMAIL_HOST_PASSWORD=A_REMPLIR
DEFAULT_FROM_EMAIL=EazyMarket <no-reply@VOTRE-DOMAINE.com>

# ---------- Modèle économique ----------
# 0 = la boutique s'ouvre au paiement du pack. Mettre 2 rétablit l'essai gratuit.
SHOP_FREE_SLOTS=0
SHOP_PACK_SIZE=10
SHOP_PACK_PRICE=5000
COMMISSION_RATE=5
COMMISSION_MIN=100
ARTISAN_SUB_PRICE=1000
ARTISAN_SUB_DAYS=90
# True = les artisans s'inscrivent et apparaissent SANS payer (opération de
# lancement). Remettre False dès que l'annuaire est assez rempli, sinon
# l'abonnement ne rapporte rien.
ARTISAN_FREE_LAUNCH=False
ARTISAN_BOOST_PRICE=2000
ARTISAN_BOOST_DAYS=7
CONTACT_UNLOCK_PRICE=200
CONTACT_UNLOCK_DAYS=90
CONTACT_FREE_UNLOCKS=1
DELIVERY_REQUIRED_SHARES=3
DELIVERY_FEE_CITY=1000
DELIVERY_FEE_OUT=2500
FREE_DELIVERY_FROM=50000
PAYOUT_MIN=5000
PAYOUT_DELAY_DAYS=3
# Montant minimum pour rendre l'argent sur mobile money plutôt qu'en avoir.
# En dessous, les frais d'envoi coûtent plus cher que la somme rendue.
REFUND_MIN=500
# Jours pendant lesquels le client peut dire « je n'ai rien reçu » après la
# livraison. L'argent du vendeur reste bloqué pendant cette fenêtre.
DISPUTE_WINDOW_DAYS=3
# Au bout de ce délai, une commande confirmée mais jamais marquée livrée
# remonte dans la vérification.
DELIVERY_ALERT_DAYS=10

# ---------- Paiements ----------
PAYMENT_PROVIDER=manual
PUBLIC_BASE_URL=https://boutique.VOTRE-DOMAINE.com

ORANGE_USSD_TEMPLATE=*144*10*{numero}*{montant}#
ORANGE_MONEY_NUMBER_1=+226 64 69 12 08
ORANGE_MONEY_WHATSAPP_1=22664691208
ORANGE_MONEY_NUMBER_2=+226 46 31 90 94
ORANGE_MONEY_NAME=EAZYMARKET
MOOV_MONEY_NUMBER=+226 02 09 66 85
WAVE_NUMBER=+226 77 55 20 87
WAVE_WHATSAPP=22677552087

# CinetPay — plus tard, quand la validation manuelle deviendra pénible
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# ---------- Confirmation des commandes ----------
# Temps laissé au vendeur pour dire s'il a bien l'article. Passé ce délai,
# la commande est annulée et le client remboursé automatiquement (en avoir).
ORDER_CONFIRMATION_HOURS=24
# Nombre d'annulations avant suspension automatique de la boutique.
SELLER_MAX_CANCELLATIONS=5
# Nombre d'annulations à partir duquel le vendeur reçoit un avertissement.
SELLER_ALERT_CANCELLATIONS=2
# Quantité maximum commandable pour un article « sur commande ».
MADE_TO_ORDER_MAX=20

# ---------- Notifications SMS ----------
# Au Burkina, beaucoup de vendeurs n'ont pas d'e-mail : le SMS est ce qui
# les prévient vraiment qu'une commande payée attend leur réponse.
#   log    = aucun envoi, le message est écrit dans logs/ (par défaut, gratuit)
#   http   = passerelle SMS générique (la plupart des revendeurs locaux)
#   orange = API Orange SMS (developer.orange.com)
SMS_PROVIDER=log
SMS_ENABLED=True
SMS_SENDER=EAZYMARKET

# --- si SMS_PROVIDER=http ---
# Demandez à votre revendeur SMS le nom exact de ses trois paramètres.
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_TOKEN=
SMS_HTTP_FIELD_TO=to
SMS_HTTP_FIELD_MESSAGE=message
SMS_HTTP_FIELD_SENDER=sender

# --- si SMS_PROVIDER=orange ---
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NUMBER=
ORANGE_SMS_BASE_URL=https://api.orange.com

# ---------- Vidéos ----------
# Une vidéo de quelques secondes est la meilleure preuve qu'un vendeur possède
# vraiment son article. Mais une vidéo pèse lourd : gardez ces limites basses
# tant que votre hébergement est mutualisé.
# Un lien TikTok / YouTube ne consomme AUCUN emplacement (il ne coûte ni disque
# ni bande passante) : c'est la solution gratuite proposée aux vendeurs.
VIDEO_FREE_SLOTS=3
VIDEO_PACK_SIZE=5
VIDEO_PACK_PRICE=500
VIDEO_MAX_SECONDS=30
VIDEO_MAX_MB=15
VIDEO_MAX_PAR_FICHE=3
# Doit rester sous upload_max_filesize / post_max_size réglés dans cPanel.
MAX_UPLOAD_MB=20

# ---------- Sécurité de la connexion ----------
# Blocage anti-force-brute : après MAX échecs en FENETRE minutes, l'IP est
# bloquée pendant BLOCAGE minutes. Laissez tel quel si vous ne savez pas.
LOGIN_MAX_ECHECS=5
LOGIN_FENETRE_MINUTES=15
LOGIN_BLOCAGE_MINUTES=15
